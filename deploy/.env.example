# Copy to deploy/.env and fill in. deploy/.env is gitignored.
# Postgres roles (generate once, e.g. `openssl rand -hex 24`)
DB_PASSWORD=change-me-kinetic-agent
MIGRATOR_PASSWORD=change-me-migrator

# Model provider (P0: env fallback on the runtime container)
# OpenRouter is OpenAI-compatible: base URL is fixed below, key is yours.
OPENROUTER_API_KEY=sk-or-v1-...
# Model id until the app constant is decided (OpenRouter "provider/model" form)
MODEL_ID=openai/gpt-4o-mini
